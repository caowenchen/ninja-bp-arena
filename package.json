{
  "name": "ninja-bp-arena",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "description": "忍界 BP · 火影忍者手游武斗赛 BP 模拟器（玩家制作的非官方工具）",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "vite build --mode pages && node scripts/copy-404.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:functions": "deno check --config supabase/functions/deno.json supabase/functions/room-command/index.ts supabase/functions/room-create/index.ts supabase/functions/room-join/index.ts",
    "test:db": "psql \"postgresql://postgres:postgres@127.0.0.1:54322/postgres\" -v ON_ERROR_STOP=1 -f supabase/tests/db-security-verify.sql",
    "test:online": "playwright test --config playwright.online.config.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "lucide-react": "^0.539.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.1.8",
    "@types/node": "^26.4.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "supabase": "^2.116.0",
    "tailwindcss": "^4.1.8",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  }
}
